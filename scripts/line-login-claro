#!/bin/sh
# Opens the LINE (Dark Mode) profile WITHOUT dark mode, only to log in with the QR code.
# After logging in, close this window and open "LINE (Dark Mode)" as usual.
EXT_ID="ophjlpahpchlmihnnnihgmmeilfjmjjc"
PROFILE="$HOME/.var/app/com.brave.Browser/config/BraveSoftware/Brave-LINE-Oscuro"
exec flatpak run com.brave.Browser --user-data-dir="$PROFILE" --no-first-run --no-default-browser-check --app="chrome-extension://$EXT_ID/index.html"
